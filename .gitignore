# ==============================
# Dataset and sensitive data
# ==============================

data/*
!data/.gitkeep

.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ==============================
# Python
# ==============================

__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ==============================
# Machine Learning artifacts
# ==============================

# Ignore generated models by default.
# Explicitly add small, useful final artifacts if needed.
models/*
!models/.gitkeep

# Generated reports and temporary outputs
reports/*
!reports/.gitkeep

# Generated visualizations
visualizations/*
!visualizations/.gitkeep

# ==============================
# Frontend / Node
# ==============================

node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# IDE and operating system
# ==============================

.vscode/
.idea/

.DS_Store
Thumbs.db
desktop.ini
